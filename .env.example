# ─── Database ────────────────────────────────────────────────────
# Prisma connection string for PostgreSQL (Supabase, Neon, etc.)
# See: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── Authentication ──────────────────────────────────────────────
# JWT secret for signing auth tokens.
# Generate one with:  openssl rand -base64 32
JWT_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# ─── Rate Limiting (Phase 3) ─────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://YOUR_REDIS_URL.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_REDIS_TOKEN"

# ─── Object Storage (Phase 4) ────────────────────────────────────
BLOB_READ_WRITE_TOKEN="YOUR_VERCEL_BLOB_TOKEN"

# ─── Cron Jobs ───────────────────────────────────────────────────
# Secret for authenticating Vercel Cron Job requests
# Generate one with:  openssl rand -base64 32
CRON_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# ─── Email Service ───────────────────────────────────────────────
RESEND_API_KEY="re_..."

# Resend Sender Email
#RESEND_FROM_EMAIL="America Dispatch TMS <suporte@americadispatch.com>"

# ─── App URL ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Stripe (Carrier Billing) ────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
